.claude/settings.local.json
.claude/worktrees/
target/

# Per-project manifest cache (`<cli> commands --json`), written into any Tina4
# project the client runs `--help` in. Never committed.
.tina4/

# Signing material (certs/keys used by sign-mac.sh / sign-release.*). The EV
# private key lives only in the SimplySign cloud HSM; these are local artifacts
# (leaf/intermediate PEMs, DERs) that never belong in git.
secrets/

# Built release binaries (produced by CI, never committed)
tina4-linux-amd64
tina4-linux-arm64
tina4-darwin-amd64
tina4-darwin-arm64
tina4-windows-amd64.exe
tina4-windows-amd64.exe.zip

# scratch dir from a local musl cross-build
target-musl/

# Stray framework-project env files (never part of the Rust CLI)
.env
.env.example
