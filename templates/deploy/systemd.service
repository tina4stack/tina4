# Tina4 systemd unit — generated by `tina4 deploy systemd`.
# Drop into /etc/systemd/system/ and enable. Adjust User=, WorkingDirectory=,
# and EnvironmentFile= for your host before activating.

[Unit]
Description=Tina4 ({{LANGUAGE}}) — {{PROJECT}}
After=network.target

[Service]
Type=simple
User=tina4
Group=tina4
WorkingDirectory=/srv/{{PROJECT}}
EnvironmentFile=/srv/{{PROJECT}}/.env
ExecStart=/usr/local/bin/tina4 serve --production
Restart=on-failure
RestartSec=5
# Tina4 binds its own port; no privileged caps needed.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
