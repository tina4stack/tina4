# Tina4 Python — production Docker image. Generated by `tina4 deploy docker`.
# Slim two-stage build: install deps with uv into a virtualenv, copy the
# resolved tree into a runtime image. No SCSS watcher, no dev tooling.
FROM python:3.12-slim AS deps
WORKDIR /app
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev

FROM python:3.12-slim
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    TINA4_OVERRIDE_CLIENT=true \
    TINA4_DEBUG=false
COPY --from=deps /app/.venv /app/.venv
COPY . /app
EXPOSE 7146
# The console script declared by tina4-python ([project.scripts]
# tina4python = "tina4_python.cli:main"). NOT `python -m tina4_python.cli`:
# tina4_python.cli is a PACKAGE with no __main__.py, so -m cannot execute it.
CMD ["tina4python", "serve", "--production"]
