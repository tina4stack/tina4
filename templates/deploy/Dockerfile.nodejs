# Tina4 Node.js — production Docker image. Generated by `tina4 deploy docker`.
# Slim two-stage: install deps + tsx, copy into runtime.
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production \
    TINA4_OVERRIDE_CLIENT=true \
    TINA4_DEBUG=false
COPY --from=deps /app/node_modules /app/node_modules
COPY . /app
EXPOSE 7148
# The `bin` declared by the tina4-nodejs package. NOT
# `npx tsx packages/cli/src/bin.ts`: that path exists only inside the
# tina4-nodejs monorepo (an installed project has node_modules/tina4-nodejs/),
# and tsx is a devDependency that `npm ci --omit=dev` strips, so npx would
# have to fetch it off the network at container start.
CMD ["npx", "tina4nodejs", "serve", "--production"]
