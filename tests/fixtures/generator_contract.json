{
  "$comment": "Naming contract for the tina4 generators, driven by scripts/generator_parity_gate.py. ADR-0094: `generate crud <Name>` emits the model + migration + an AutoCrud-backed admin PAGE rendered by Crud.to_crud at /admin/<table>, in a route file NAMED BY THE TABLE (src/routes/<table>.<ext>) - singular for a normal word (product), pluralised only for a SQL reserved word (order -> orders). There is no pages/<plural>.twig list view any more, and the route segment is the table, not a blanket plural. Verified against all four frameworks.",
  "schema_version": "1",
  "envelope_name": "generator_contract_v1",
  "model": {
    "class": "Widget",
    "table": "widget",
    "migration": "create_widget"
  },
  "crud": [
    {
      "name": "Product",
      "fields": "name:string",
      "table": "product",
      "migration": "create_product",
      "route_paths": [
        "/api/products"
      ],
      "route_segment": "product"
    },
    {
      "name": "Order",
      "fields": "total:float",
      "reserved_word": true,
      "table": "orders",
      "migration": "create_orders",
      "route_paths": [
        "/api/orders"
      ],
      "must_not_appear": [
        "orderss",
        "/api/orderss"
      ],
      "route_segment": "orders"
    }
  ],
  "languages": {
    "python": {
      "cli_available": true,
      "model_file": "src/orm/Widget.py",
      "migration_glob": "migrations/*_create_widget.sql",
      "crud_files": {
        "Product": [
          "src/orm/Product.py",
          "src/routes/product.py"
        ],
        "Order": [
          "src/orm/Order.py",
          "src/routes/orders.py"
        ]
      },
      "crud_admin_marker": "to_crud"
    },
    "php": {
      "cli_available": true,
      "model_file": "src/orm/Widget.php",
      "migration_glob": "migrations/*_create_widget.sql",
      "crud_files": {
        "Product": [
          "src/orm/Product.php",
          "src/routes/product.php"
        ],
        "Order": [
          "src/orm/Order.php",
          "src/routes/orders.php"
        ]
      },
      "crud_admin_marker": "toCrud"
    },
    "ruby": {
      "cli_available": true,
      "model_file": "src/orm/widget.rb",
      "migration_glob": "migrations/*_create_widget.sql",
      "crud_files": {
        "Product": [
          "src/orm/product.rb",
          "src/routes/product.rb"
        ],
        "Order": [
          "src/orm/order.rb",
          "src/routes/orders.rb"
        ]
      },
      "crud_admin_marker": "to_crud"
    },
    "nodejs": {
      "cli_available": true,
      "generator_incomplete": {
        "id": "nodejs-generate-not-implemented",
        "why": "the published tina4-nodejs package's `generate` is a no-op: `tina4 init nodejs` scaffolds a project, but `generate model`/`generate crud` emit no files and `routes` lists nothing. This is a framework gap (the Node generators are not shipped), not a CLI dispatch bug \u2014 the CLI forwards generate verbatim and PHP/Python/Ruby all emit. Remove this marker once tina4-nodejs ships generate."
      },
      "model_file_globs": [
        "src/orm/Widget.ts",
        "src/orm/Widget.js"
      ],
      "migration_glob": "migrations/*_create_widget.sql",
      "crud_files_globs": {
        "Product": [
          "src/routes/product.*"
        ],
        "Order": [
          "src/routes/orders.*"
        ]
      },
      "crud_admin_marker": "toCrud"
    }
  },
  "tina4js": {
    "$comment": "bug 3: generate must delegate to tina4js, not vite.",
    "page": {
      "name": "Home",
      "files": [
        "public/js/home-page.js",
        "src/public/home.html"
      ]
    },
    "component": {
      "name": "WidgetCard",
      "files": [
        "public/js/components/widget-card.js"
      ]
    }
  },
  "routes_min_registered": 4
}
