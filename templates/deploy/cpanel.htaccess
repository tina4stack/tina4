# Tina4 cPanel / Apache .htaccess — generated by `tina4 deploy cpanel`.
# cPanel hosts run Apache; this file routes every request that isn't a
# static file or directory through index.php (PHP) or your language's
# entry point. Adjust the rewrite target if you're not on PHP.

RewriteEngine On

# Static files and directories pass through untouched.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else hits the framework entry point.
RewriteRule ^ index.php [L]

# Common-sense headers — let cPanel-managed certs negotiate HTTPS, and
# stop browsers caching index.php.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "\.(env|sqlite|db|log|md)$">
    Require all denied
</FilesMatch>
