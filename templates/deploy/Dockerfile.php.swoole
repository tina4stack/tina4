# Tina4 PHP — SWOOLE production image. Generated by `tina4 deploy docker --runtime swoole`.
#
# WHEN TO PICK THIS. Swoole keeps the whole app resident between requests: no
# per-request bootstrap, coroutines for concurrent I/O, and long-lived
# connections. It is the fastest of the three runtimes for API workloads, and
# the one with the most rules attached.
#
# THE RULES, because a resident app is not the same program as a per-request one:
#   - Anything you write to a static/global lives for the life of the WORKER,
#     not the request. That is a memory leak with extra steps.
#   - TINA4_DEBUG must be false. DevAdmin::$messages and DevAdmin::$requests are
#     process-static arrays that only ever grow, so a debug-mode Swoole worker
#     climbs until it is killed.
#   - max_request recycles a worker after N requests. It is a safety net for
#     leaks you have not found yet, not a licence to leak.
#
# If none of that sounds worth it, use the fpm or the default cli image. They
# are slower per request and they cannot leak between requests.
ARG TINA4_CLI_IMAGE=ghcr.io/tina4stack/tina4-cli:v3.8.63
FROM ${TINA4_CLI_IMAGE} AS tina4cli

FROM composer:2 AS deps
WORKDIR /app
COPY composer.json composer.lock* ./
RUN composer install --no-dev --optimize-autoloader --no-scripts

FROM php:8.4-cli
WORKDIR /app
COPY --from=tina4cli /usr/local/bin/tina4 /usr/local/bin/tina4

# openswoole from PECL. The build is FAIL-LOUD on purpose: if the extension
# does not load, the image must not build. A silently-missing swoole would
# produce an image whose CMD dies at container start with a fatal, which is
# exactly the class of failure `tina4 deploy` exists to stop shipping.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libbrotli-dev libssl-dev libsqlite3-dev \
 && docker-php-ext-install -j"$(nproc)" pdo_sqlite opcache \
 && pecl install -f openswoole \
 && echo "extension=openswoole.so" > /usr/local/etc/php/conf.d/99-openswoole.ini \
 && php -m | grep -qi '^openswoole$' \
 && php -r 'if (!class_exists("Swoole\Http\Server")) { fwrite(STDERR, "no Swoole\Http\Server\n"); exit(1); }' \
 && apt-get purge -y --auto-remove \
 && rm -rf /var/lib/apt/lists/*

COPY --from=deps /app/vendor /app/vendor
COPY . /app

# server.php is the Swoole entry point. It is written here rather than expected
# from the project so that `tina4 deploy docker --runtime swoole` produces an
# image that actually runs against a stock scaffold.
COPY server.php /app/server.php

ENV TINA4_OVERRIDE_CLIENT=true \
    TINA4_DEBUG=false \
    TINA4_SWOOLE_HOST=0.0.0.0 \
    TINA4_SWOOLE_PORT=7145
EXPOSE 7145

# No `tina4 serve` here: the CLI launches the framework's own server, and this
# image's whole point is that Swoole is the server instead.
CMD ["php", "/app/server.php"]
